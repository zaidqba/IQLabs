# ─── IQ-RAD Environment Configuration ──────────────────────────────────────
# Copy this file to .env and fill in all values before starting the application.
# NEVER commit .env to source control.

# ─── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=development   # development | staging | production
LOG_LEVEL=INFO

# ─── Database ────────────────────────────────────────────────────────────────
# Production: Ionetix3/SQLEXPRESS
# Development: Docker SQL Server container
DATABASE_URL=mssql+pyodbc://iq_rad:changeme@localhost:1433/IQ_RAD?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# For dev Docker SQL Server container only:
SA_PASSWORD=DevOnly_StrongPwd1!
DB_PASSWORD=DevOnly_IqRad1!

# ─── Rotem Device Connectors ──────────────────────────────────────────────────
ROTEM_STACK_HOST=10.0.0.160
ROTEM_STACK_PORT=4001
ROTEM_DPU3_HOST=10.0.0.160
ROTEM_DPU3_PORT=5000
CONNECTION_UNIT_HOST=localhost
CONNECTION_UNIT_PORT=15386

# Polling interval in seconds (default 10)
POLL_INTERVAL_S=10
# TCP connect timeout in seconds
CONNECT_TIMEOUT_S=5.0
# TCP read timeout in seconds
READ_TIMEOUT_S=8.0

# ─── Security ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-256-bit-random-hex-CHANGE-ME
HMAC_SECRET=replace-with-256-bit-random-hex-CHANGE-ME

JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_HOURS=8
JWT_ALGORITHM=HS256

# Account lockout after N consecutive failures
LOGIN_MAX_FAILURES=5

# ─── NTP ─────────────────────────────────────────────────────────────────────
NTP_SERVER=pool.ntp.org
# Maximum allowed clock drift in milliseconds before readings flagged SUSPECT
MAX_NTP_DRIFT_MS=500

# ─── Application ─────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=2
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ─── Frontend (set at build time) ────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws/live
