# ─── IQ-RAD Production Environment ────────────────────────────────────────────
# Copy this to .env and fill in EVERY value before running docker compose.
# NEVER commit the real .env file to git.

# ── Database ───────────────────────────────────────────────────────────────────
# Connects to existing Ionetix3/SQLEXPRESS on the LAN.
# The backend container uses host.docker.internal to reach the LAN SQL Server.
# If Ionetix3 resolves on the LAN, use its hostname. Otherwise use its IP.
DATABASE_URL=mssql+aioodbc://iq_rad_user:CHANGE_PASSWORD@Ionetix3/IQ_RAD?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ── Security — CHANGE BOTH BEFORE FIRST LAUNCH ────────────────────────────────
# Must be at least 32 random characters each.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING_BEFORE_LAUNCH_111111111111111
HMAC_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING_BEFORE_LAUNCH_222222222222222

# ── Rotem Device Addresses ─────────────────────────────────────────────────────
ROTEM_STACK_HOST=10.0.0.160
ROTEM_STACK_PORT=4001
ROTEM_DPU3_HOST=10.0.0.160
ROTEM_DPU3_PORT=5000
ROTEM_POLL_INTERVAL_S=5

# ── NTP ────────────────────────────────────────────────────────────────────────
NTP_SERVER=pool.ntp.org
MAX_NTP_DRIFT_MS=500

# ── App ────────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
LOGIN_MAX_FAILURES=5
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8

# ── Reports directory (mapped to Docker volume) ────────────────────────────────
REPORTS_DIR=/app/reports
